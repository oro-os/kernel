from oro import package, artifact, file, limine, ramdisk
from oro_contrib import iso

LIMINE_BIOS_CD = file './bin/limine-bios-cd.bin'
LIMINE_BIOS_SYS = file './bin/limine-bios.sys'
LIMINE_BIOS_HDD = file './bin/limine-bios-hdd.bin'

ARCH_EFI_FILES =
	'x86-64': file './bin/BOOTX64.EFI'
	'aarch64': file './bin/BOOTAA64.EFI'
	'riscv64': file './bin/BOOTRISCV64.EFI'

limine_cfg = |comment: String, archs...| file.from_str "
timeout: 0
quiet: yes
default_entry: 1
graphics: yes
randomise_memory: no
interface_branding: Oro Operating System
interface_branding_color: 5

/Oro:
	comment: {comment}
	protocol: limine
	path: boot():/boot/oro-limine-$\{ARCH}
	module_path: boot():/oro.rd
	randomise_hhdm_base: yes
	kasler: no
	serial: yes

	{if archs.is_empty() then '' else 'if_arch: {archs.join ' '}'}
"

oro_ramdisk = |kernels|
	rd = ramdisk.builder()
	for arch, kernel in kernels
		rd.item ramdisk.kernel(kernel, arch).compress()
	rd.file()

export
	'limine-multiarch-dev': || package
		.arch('x86_64', 'aarch64', 'riscv64')
		.single_file 'iso', |out|
			boot =
				'limine.conf': limine_cfg('[DEV] Oro Operating System (Multi-arch)', 'x86-64', 'aarch64', 'riscv64')
				'oro-limine-x86-64': artifact.limine.x86_64.dev
				'oro-limine-aarch64': artifact.limine.aarch64.dev
				'oro-limine-riscv64': artifact.limine.riscv64.dev
				'oro-kernel-x86-64': artifact.kernel.x86_64.dev
				'oro-kernel-aarch64': artifact.kernel.aarch64.dev
				'oro-kernel-riscv64': artifact.kernel.riscv64.dev
				'limine-bios.sys': LIMINE_BIOS_SYS
				'limine-bios-cd.bin': LIMINE_BIOS_CD

			efi =
				'BOOTX64.EFI': ARCH_EFI_FILES.get 'x86-64'
				'BOOTAA64.EFI': ARCH_EFI_FILES.get 'aarch64'
				'BOOTRISCV64.EFI': ARCH_EFI_FILES.get 'riscv64'

			kernels =
				'x86_64': artifact.kernel.x86_64.dev
				'aarch64': artifact.kernel.aarch64.dev
				'riscv64': artifact.kernel.riscv64.dev

			fs = {
				boot,
				EFI: { BOOT: efi },
				'oro.rd': oro_ramdisk(kernels),
			}

			iso.for_emulators()
				.volume_id 'ORO-EMU-LIMINE-MULTI-DEV'
				.boot_bios ['boot', 'limine-bios-cd.bin']
				.boot_uefi ['EFI', 'BOOT', 'BOOTX64.EFI']
				.filesystem fs
				.build out

			limine.bios_install out, LIMINE_BIOS_HDD

	'limine-multiarch': || package
		.arch('x86_64', 'aarch64', 'riscv64')
		.single_file 'iso', |out|
			boot =
				'limine.conf': limine_cfg('Oro Operating System (Multi-arch)', 'x86-64', 'aarch64', 'riscv64')
				'oro-limine-x86-64': artifact.limine.x86_64.release
				'oro-limine-aarch64': artifact.limine.aarch64.release
				'oro-limine-riscv64': artifact.limine.riscv64.release
				'oro-kernel-x86-64': artifact.kernel.x86_64.release
				'oro-kernel-aarch64': artifact.kernel.aarch64.release
				'oro-kernel-riscv64': artifact.kernel.riscv64.release
				'limine-bios.sys': LIMINE_BIOS_SYS
				'limine-bios-cd.bin': LIMINE_BIOS_CD

			efi =
				'BOOTX64.EFI': ARCH_EFI_FILES.get 'x86-64'
				'BOOTAA64.EFI': ARCH_EFI_FILES.get 'aarch64'
				'BOOTRISCV64.EFI': ARCH_EFI_FILES.get 'riscv64'

			kernels =
				'x86_64': artifact.kernel.x86_64.release
				'aarch64': artifact.kernel.aarch64.release
				'riscv64': artifact.kernel.riscv64.release

			fs = {
				boot,
				EFI: { BOOT: efi },
				'oro.rd': oro_ramdisk(kernels),
			}

			iso.for_emulators()
				.volume_id 'ORO-EMU-LIMINE-MULTI'
				.boot_bios ['boot', 'limine-bios-cd.bin']
				.boot_uefi ['EFI', 'BOOT', 'BOOTX64.EFI']
				.filesystem fs
				.build out

			limine.bios_install out, LIMINE_BIOS_HDD

	'limine-x86_64-dev': || package
		.arch('x86_64')
		.single_file 'iso', |out|
			boot =
				'limine.conf': limine_cfg('[DEV] Oro Operating System (x86-64)', 'x86-64')
				'oro-limine-x86-64': artifact.limine.x86_64.dev
				'oro-kernel-x86-64': artifact.kernel.x86_64.dev
				'limine-bios.sys': LIMINE_BIOS_SYS
				'limine-bios-cd.bin': LIMINE_BIOS_CD

			efi =
				'BOOTX64.EFI': ARCH_EFI_FILES.get 'x86-64'

			kernels = { 'x86_64': artifact.kernel.x86_64.dev }

			fs = {
				boot,
				EFI: { BOOT: efi },
				'oro.rd': oro_ramdisk(kernels),
			}

			iso.for_emulators()
				.volume_id 'ORO-EMU-LIMINE-X64-DEV'
				.boot_bios ['boot', 'limine-bios-cd.bin']
				.boot_uefi ['EFI', 'BOOT', 'BOOTX64.EFI']
				.filesystem fs
				.build out

			limine.bios_install out, LIMINE_BIOS_HDD

	'limine-x86_64': || package
		.arch('x86_64')
		.single_file 'iso', |out|
			boot =
				'limine.conf': limine_cfg('Oro Operating System (x86-64)', 'x86-64')
				'oro-limine-x86-64': artifact.limine.x86_64.release
				'oro-kernel-x86-64': artifact.kernel.x86_64.release
				'limine-bios.sys': LIMINE_BIOS_SYS
				'limine-bios-cd.bin': LIMINE_BIOS_CD

			efi =
				'BOOTX64.EFI': ARCH_EFI_FILES.get 'x86-64'

			kernels = { 'x86_64': artifact.kernel.x86_64.release }

			fs = {
				boot,
				EFI: { BOOT: efi },
				'oro.rd': oro_ramdisk(kernels),
			}

			iso.for_emulators()
				.volume_id 'ORO-EMU-LIMINE-X64'
				.boot_bios ['boot', 'limine-bios-cd.bin']
				.boot_uefi ['EFI', 'BOOT', 'BOOTX64.EFI']
				.filesystem fs
				.build out

			limine.bios_install out, LIMINE_BIOS_HDD

	'limine-aarch64-dev': || package
		.arch('aarch64')
		.single_file 'iso', |out|
			boot =
				'limine.conf': limine_cfg('[DEV] Oro Operating System (AArch64)', 'aarch64')
				'oro-limine-aarch64': artifact.limine.aarch64.dev
				'oro-kernel-aarch64': artifact.kernel.aarch64.dev
				'limine-bios.sys': LIMINE_BIOS_SYS
				'limine-bios-cd.bin': LIMINE_BIOS_CD

			efi =
				'BOOTAA64.EFI': ARCH_EFI_FILES.get 'aarch64'

			kernels = { 'aarch64': artifact.kernel.aarch64.dev }

			fs = {
				boot,
				EFI: { BOOT: efi },
				'oro.rd': oro_ramdisk(kernels),
			}

			iso.for_emulators()
				.volume_id 'ORO-EMU-LIMINE-AA64-DEV'
				.boot_bios ['boot', 'limine-bios-cd.bin']
				.boot_uefi ['EFI', 'BOOT', 'BOOTAA64.EFI']
				.filesystem fs
				.build out

			limine.bios_install out, LIMINE_BIOS_HDD

	'limine-aarch64': || package
		.arch('aarch64')
		.single_file 'iso', |out|
			boot =
				'limine.conf': limine_cfg('Oro Operating System (AArch64)', 'aarch64')
				'oro-limine-aarch64': artifact.limine.aarch64.release
				'oro-kernel-aarch64': artifact.kernel.aarch64.release
				'limine-bios.sys': LIMINE_BIOS_SYS
				'limine-bios-cd.bin': LIMINE_BIOS_CD

			efi =
				'BOOTAA64.EFI': ARCH_EFI_FILES.get 'aarch64'

			kernels = { 'aarch64': artifact.kernel.aarch64.release }

			fs = {
				boot,
				EFI: { BOOT: efi },
				'oro.rd': oro_ramdisk(kernels),
			}

			iso.for_emulators()
				.volume_id 'ORO-EMU-LIMINE-AA64'
				.boot_bios ['boot', 'limine-bios-cd.bin']
				.boot_uefi ['EFI', 'BOOT', 'BOOTAA64.EFI']
				.filesystem fs
				.build out

			limine.bios_install out, LIMINE_BIOS_HDD


	'limine-riscv64-dev': || package
		.arch('riscv64')
		.single_file 'iso', |out|
			boot =
				'limine.conf': limine_cfg('[DEV] Oro Operating System (RISC-V 64)', 'riscv64')
				'oro-limine-riscv64': artifact.limine.riscv64.dev
				'oro-kernel-riscv64': artifact.kernel.riscv64.dev
				'limine-bios.sys': LIMINE_BIOS_SYS
				'limine-bios-cd.bin': LIMINE_BIOS_CD

			efi =
				'BOOTRISCV64.EFI': ARCH_EFI_FILES.get 'riscv64'

			kernels = { 'riscv64': artifact.kernel.riscv64.dev }

			fs = {
				boot,
				EFI: { BOOT: efi },
				'oro.rd': oro_ramdisk(kernels),
			}

			iso.for_emulators()
				.volume_id 'ORO-EMU-LIMINE-RV64-DEV'
				.boot_bios ['boot', 'limine-bios-cd.bin']
				.boot_uefi ['EFI', 'BOOT', 'BOOTRISCV64.EFI']
				.filesystem fs
				.build out

			limine.bios_install out, LIMINE_BIOS_HDD

	'limine-riscv64': || package
		.arch('riscv64')
		.single_file 'iso', |out|
			boot =
				'limine.conf': limine_cfg('Oro Operating System (RISC-V 64)', 'riscv64')
				'oro-limine-riscv64': artifact.limine.riscv64.release
				'oro-kernel-riscv64': artifact.kernel.riscv64.release
				'limine-bios.sys': LIMINE_BIOS_SYS
				'limine-bios-cd.bin': LIMINE_BIOS_CD

			efi =
				'BOOTRISCV64.EFI': ARCH_EFI_FILES.get 'riscv64'

			kernels = { 'riscv64': artifact.kernel.riscv64.release }

			fs = {
				boot,
				EFI: { BOOT: efi },
				'oro.rd': oro_ramdisk(kernels),
			}

			iso.for_emulators()
				.volume_id 'ORO-EMU-LIMINE-RV64'
				.boot_bios ['boot', 'limine-bios-cd.bin']
				.boot_uefi ['EFI', 'BOOT', 'BOOTRISCV64.EFI']
				.filesystem fs
				.build out

			limine.bios_install out, LIMINE_BIOS_HDD
